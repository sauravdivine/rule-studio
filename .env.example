# Copy to .env (git-ignored) for local development:  cp .env.example .env
# The API validates these at startup (apps/api/src/common/config/env.ts).

NODE_ENV=development
PORT=3000

# Postgres from docker-compose.yml. Change these together if you change one.
POSTGRES_USER=rulestudio
POSTGRES_PASSWORD=rulestudio
POSTGRES_DB=rulestudio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rulestudio:rulestudio@localhost:5432/rulestudio
