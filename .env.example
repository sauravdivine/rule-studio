# Copy to .env (git-ignored) for local development:  cp .env.example .env
# The API validates these at startup (apps/api/src/common/config/env.ts).

NODE_ENV=development
PORT=3000

# Postgres from docker-compose.yml. Change these together if you change one.
POSTGRES_USER=rulestudio
POSTGRES_PASSWORD=rulestudio
POSTGRES_DB=rulestudio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rulestudio:rulestudio@localhost:5432/rulestudio

# Access-token signing key (RS256). Leave empty here and run `npm run jwt:keys`, which
# fills in both values in .env. Never commit a real key.
JWT_PRIVATE_KEY=
JWT_KEY_ID=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Password for the three seeded demo users (viewer@, editor@, admin@rulestudio.dev).
# Used by `npx nx run api:db-seed`, and by the shell's demo sign-in buttons (read when
# the shell starts, so restart it after a change). Public by design. At least 8 characters.
SEED_DEMO_PASSWORD=rulestudio-demo
