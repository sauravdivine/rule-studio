{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rule-studio.dev/contracts/ruleset.schema.json",
  "title": "Ruleset",
  "description": "A ruleset's working document: its identity (id, name, description) plus its rule content. Publishing and versions are defined in spec 003. See specs/001-ruleset-data-model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "schemaVersion",
    "inputFields",
    "hitStrategy",
    "defaultAction",
    "rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "schemaVersion": {
      "description": "Version of this JSON format, not of the ruleset's content. Bumped only when the format changes.",
      "const": 1
    },
    "inputFields": {
      "description": "The input data model: the fields rules may reference.",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/InputField"
      }
    },
    "hitStrategy": {
      "$ref": "#/$defs/HitStrategy"
    },
    "defaultAction": {
      "description": "The action taken when no rule fires.",
      "$ref": "#/$defs/Action"
    },
    "rules": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/Rule"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "HitStrategy": {
      "description": "FIRST: the first matching rule (by priority) decides. PRIORITY: all matching rules fire; the strictest decision wins.",
      "type": "string",
      "enum": ["FIRST", "PRIORITY"]
    },
    "Decision": {
      "type": "string",
      "enum": ["APPROVE", "REJECT", "REFER"]
    },
    "FieldType": {
      "type": "string",
      "enum": ["NUMBER", "STRING", "BOOLEAN", "DATE"]
    },
    "InputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "maxLength": 50
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "$ref": "#/$defs/FieldType"
        },
        "allowedValues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "priority", "enabled", "when", "then"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "when": {
          "$ref": "#/$defs/ConditionGroup"
        },
        "then": {
          "$ref": "#/$defs/Action"
        }
      }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "LogicalOperator": {
      "type": "string",
      "enum": ["AND", "OR"]
    },
    "ConditionGroup": {
      "description": "Top-level group (depth 1). Children may be conditions or depth-2 groups.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operator", "children"],
      "properties": {
        "type": {
          "const": "group"
        },
        "operator": {
          "$ref": "#/$defs/LogicalOperator"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Condition"
              },
              {
                "$ref": "#/$defs/ConditionGroupLevel2"
              }
            ]
          }
        }
      }
    },
    "ConditionGroupLevel2": {
      "description": "Nested group (depth 2). Children may be conditions or depth-3 groups.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operator", "children"],
      "properties": {
        "type": {
          "const": "group"
        },
        "operator": {
          "$ref": "#/$defs/LogicalOperator"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Condition"
              },
              {
                "$ref": "#/$defs/ConditionGroupLevel3"
              }
            ]
          }
        }
      }
    },
    "ConditionGroupLevel3": {
      "description": "Deepest group (depth 3). Children may only be conditions.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operator", "children"],
      "properties": {
        "type": {
          "const": "group"
        },
        "operator": {
          "$ref": "#/$defs/LogicalOperator"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/Condition"
          }
        }
      }
    },
    "ScalarValue": {
      "type": ["string", "number", "boolean"]
    },
    "OrderedValue": {
      "type": ["string", "number"]
    },
    "Condition": {
      "description": "A single comparison. The allowed value shape depends on the operator; per-field-type checks happen in code (spec 001, Validation split).",
      "oneOf": [
        {
          "$ref": "#/$defs/SingleValueCondition"
        },
        {
          "$ref": "#/$defs/BetweenCondition"
        },
        {
          "$ref": "#/$defs/ListCondition"
        },
        {
          "$ref": "#/$defs/TextCondition"
        },
        {
          "$ref": "#/$defs/EmptinessCondition"
        }
      ]
    },
    "SingleValueCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "field", "operator", "value"],
      "properties": {
        "type": {
          "const": "condition"
        },
        "field": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": ["EQ", "NEQ", "GT", "GTE", "LT", "LTE"]
        },
        "value": {
          "$ref": "#/$defs/ScalarValue"
        }
      }
    },
    "BetweenCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "field", "operator", "value"],
      "properties": {
        "type": {
          "const": "condition"
        },
        "field": {
          "type": "string"
        },
        "operator": {
          "const": "BETWEEN"
        },
        "value": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrderedValue"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[min, max], inclusive"
        }
      }
    },
    "ListCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "field", "operator", "value"],
      "properties": {
        "type": {
          "const": "condition"
        },
        "field": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": ["IN", "NOT_IN"]
        },
        "value": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/OrderedValue"
          }
        }
      }
    },
    "TextCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "field", "operator", "value"],
      "properties": {
        "type": {
          "const": "condition"
        },
        "field": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": ["CONTAINS", "STARTS_WITH"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "EmptinessCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "field", "operator"],
      "properties": {
        "type": {
          "const": "condition"
        },
        "field": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": ["IS_EMPTY", "IS_NOT_EMPTY"]
        }
      }
    }
  }
}
